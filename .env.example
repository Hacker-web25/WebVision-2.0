# Copy to .env and export, or set these in your host's dashboard. Everything is optional for a local demo.
PORT=3000
# Where the SQLite file and the generated encryption key live.
DATA_DIR=./server/data
# 32 random bytes, base64. If unset, a key is generated once in DATA_DIR/secret.key.
# PRAVESH_KEY=
# outbox: mail is kept in the database and shown at /dev/outbox (not in production). smtp: really send.
MAILER=outbox
# SMTP_URL=smtps://user:password@smtp.example.com:465
# MAIL_FROM="Pravesh <no-reply@example.com>"
# Public address of the site, used for links inside emails.
# PUBLIC_URL=https://example.com
# Set to the number of proxies in front of the app (for correct per-IP rate limits).
# TRUST_PROXY=1
# NODE_ENV=production
# LOG_REQUESTS=1
# AI assistant. Free key from build.nvidia.com; Gemini is used if NVIDIA fails or is not set.
# NVIDIA_API_KEY=
# One model, or several comma-separated to fall back in order (fastest first).
# NVIDIA_MODEL=meta/llama-3.3-70b-instruct
# GEMINI_API_KEY=
# GEMINI_MODEL=gemini-2.0-flash
